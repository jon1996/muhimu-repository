# === Développement local (docker-compose.yml) ===
# Bêta / staging isolé : copier .env.beta.example → .env.beta
#   puis : docker compose -p muhimu-beta -f docker-compose.beta.yml --env-file .env.beta up -d

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,platform
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=muhimu
POSTGRES_USER=muhimu
POSTGRES_PASSWORD=muhimu
POSTGRES_APP_USER=muhimu_app
POSTGRES_APP_PASSWORD=muhimu
POSTGRES_PLATFORM_USER=muhimu_platform
POSTGRES_PLATFORM_PASSWORD=muhimu
REDIS_URL=redis://localhost:6379/0
# SEC-P0-01 — rate-limit login (Redis). Derrière reverse proxy uniquement :
# AUTH_TRUST_PROXY=1
# AUTH_LOGIN_MAX_ATTEMPTS_EMAIL=5
# AUTH_LOGIN_MAX_ATTEMPTS_IP=40
# AUTH_LOGIN_WINDOW_SECONDS=600
# AUTH_LOGIN_LOCKOUT_SECONDS=900
# SEC-SESSION-01 (défauts code si non définis)
# SESSION_COOKIE_AGE=43200
# SESSION_EXPIRE_AT_BROWSER_CLOSE=1
# SESSION_IDLE_TIMEOUT_SECONDS=1800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
# SESSION_POLICY_ENABLED=1
NEXT_PUBLIC_API_URL=http://localhost:8000
ERP_PUBLIC_URL=http://127.0.0.1:3001
CONSOLE_PUBLIC_URL=http://127.0.0.1:3002
# Namecheap Private Email.
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=jp@muhimu.tech
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Muhimu <jp@muhimu.tech>
# Local Docker : 1 (comptes @muhimu.local). Bêta/prod : 0
BOOTSTRAP_LOCAL_ACCOUNTS=1
STAFF_EMAIL=jp@muhimu.tech
STAFF_FULL_NAME=JP Muhimu
# STAFF_PASSWORD=  # premier mot de passe console en production uniquement
