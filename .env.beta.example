# Copier vers .env.beta et remplacer TOUTES les valeurs placeholder.
# Ne jamais committer .env.beta ni des secrets réels.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=erp.beta.localhost,console.beta.localhost,localhost,backend,platform
DJANGO_USE_X_FORWARDED_HOST=1
DJANGO_SECURE_SSL_REDIRECT=0
LOG_LEVEL=INFO

# Origins HTTPS (proxy bêta)
FRONTEND_ORIGINS=https://erp.beta.localhost:18443,https://console.beta.localhost:18443
ERP_PUBLIC_URL=https://erp.beta.localhost:18443
CONSOLE_PUBLIC_URL=https://console.beta.localhost:18443
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# --- PostgreSQL (volume postgres_beta_data — distinct du volume dev) ---
POSTGRES_DB=muhimu_beta
POSTGRES_USER=muhimu
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_APP_USER=muhimu_app
POSTGRES_APP_PASSWORD=change-me-app-password
POSTGRES_PLATFORM_USER=muhimu_platform
POSTGRES_PLATFORM_PASSWORD=change-me-platform-password

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- BETA-SCOPE-01 (périmètre fonctionnel — défaut sécurisé si DEBUG=0) ---
# BETA_SCOPE_RESTRICT=1 est implicite lorsque DJANGO_DEBUG=0.
# Mettre à 1 pour activer une bêta expérimentale (non recommandé).
# BETA_FEATURES_CONSOLIDATION=0
# BETA_FEATURES_CLASS9_CAGE=0
# BETA_FEATURES_ESG=0
# BETA_FEATURES_ESCOMPTE=0

# --- Bootstrap ---
# Interdit en bêta : pas de comptes démo automatiques.
BOOTSTRAP_LOCAL_ACCOUNTS=0

# --- BETA-TEST-01 / UAT (obligatoire pour provisioning & rotation — hors Git) ---
# BETA_TEST01_DEFAULT_PASSWORD=
STAFF_EMAIL=
STAFF_FULL_NAME=
STAFF_PASSWORD=

# --- Proxy ports (hôte) ---
BETA_HTTP_PORT=18080
BETA_HTTPS_PORT=18443

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# --- SEC-P0-01 auth ---
# Backend non publié sur l'hôte : confiance X-Real-IP depuis nginx.
AUTH_TRUST_PROXY=1
AUTH_LOGIN_RATE_LIMIT_ENABLED=1
AUTH_LOGIN_THROTTLE_BACKEND=redis
AUTH_LOGIN_MAX_ATTEMPTS_EMAIL=5
AUTH_LOGIN_MAX_ATTEMPTS_IP=40
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_AGE=43200
# SEC-SESSION-01
SESSION_POLICY_ENABLED=1
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=1
SESSION_IDLE_WARN_BEFORE_SECONDS=300

# --- Email (optionnel en bêta locale) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
